{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "orCAL",
  "identifier": "com.orcal.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "orCAL",
        "width": 360,
        "height": 720,
        "resizable": true,
        "maximizable": false,
        "transparent": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
